<a class="fv2-card" href="{{ a.url }}">
  <div class="fv2-card__img">{%- if a.image -%}{{ a.image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300,450,600', sizes: '(min-width: 760px) 300px, 100vw', alt: '' }}{%- endif -%}</div>
  <div class="fv2-card__body">
    {%- assign t = a.tags | first | default: 'Lean Management' -%}
    <span class="fv2-tag">{{ t }}</span>
    <h3>{{ a.title }}</h3>
    <span class="fv2-more">Lire l'article →</span>
  </div>
</a>
