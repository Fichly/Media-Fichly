   "module": "sendinblue:SendEmail",
   "version": 2,
   "parameters": {
    "__IMTCONN__": 7809870
   },
   "mapper": {
    "templateId": "{{switch(toString(ifempty(2.attributes.WB_ETAPE; 0)); \"0\"; 207; \"1\"; 208; \"2\"; 209; \"3\"; switch(toString(2.attributes.WB_BESOIN); \"2\"; 211; \"3\"; 212; \"4\"; 213; 210); 0)}}",
    "to": [
     {
      "email": "{{2.email}}",
      "name": "{{2.attributes.FIRSTNAME}}"
     }
    ],
    "replyTo": {
     "email": "hugo.duc@fichly.com",
     "name": "Hugo de Fichly"
    },
    "tags": [
     "white-belt-nurturing"
    ]
   },
   "metadata": {
    "designer": {
     "x": 600,
     "y": 0
    }
   },
   "filter": {
    "name": "Email suivant dû",
    "conditions": [
     [
      {
       "a": "{{2.emailBlacklisted}}",
       "o": "boolean:equal",
       "b": "false"
      },
      {
       "a": "{{if(contains(split(\"0,1,2,3\"; \",\"); toString(ifempty(2.attributes.WB_ETAPE; 0))); \"oui\"; \"non\")}}",
       "o": "text:equal",
       "b": "oui"
      },
      {
       "a": "{{if(parseNumber(formatDate(now; \"YYYYMMDD\"; \"Europe/Paris\")) >= parseNumber(formatDate(addDays(ifempty(2.attributes.WB_DERNIER_ENVOI; now); switch(toString(ifempty(2.attributes.WB_ETAPE; 0)); \"0\"; 2; \"1\"; 3; \"2\"; 4; \"3\"; 5; 99999)); \"YYYYMMDD\"; \"Europe/Paris\")); \"oui\"; \"non\")}}",
       "o": "text:equal",
       "b": "oui"
      }
     ]
    ]
   },
   "onerror": [
